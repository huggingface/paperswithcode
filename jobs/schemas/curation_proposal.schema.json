{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperswithcode.co/schemas/curation-proposal.v1.json",
  "title": "Papers With Code paper curation proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "score_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["task_id", "dataset_id", "metric", "source_value", "source_scale", "source_url", "table_reference"],
        "properties": {
          "task_id": {"type": "integer", "minimum": 1},
          "dataset_id": {"type": "integer", "minimum": 1},
          "metric": {"type": "string", "minLength": 1, "maxLength": 200},
          "source_value": {"type": "number"},
          "source_scale": {"enum": ["0-1", "0-100", "native"]},
          "source_url": {"type": "string", "pattern": "^https?://\\S+$", "maxLength": 2000},
          "table_reference": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    },
    "evaluations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["paper_id", "task_id", "dataset_id", "model_name", "metrics", "best_metric", "source_url"],
        "properties": {
          "paper_id": {"type": "integer"},
          "task_id": {"type": "integer"},
          "dataset_id": {"type": "integer"},
          "model_name": {"type": "string"},
          "harness": {"type": ["string", "null"]},
          "metrics": {"type": "object", "minProperties": 1},
          "best_metric": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": true
      }
    },
    "evaluation_removals": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["evaluation_id", "reason", "before_state", "evidence"],
        "properties": {
          "evaluation_id": {"type": "integer"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "before_state": {"type": "object"},
          "evidence": {"type": "array", "minItems": 1, "maxItems": 20}
        },
        "additionalProperties": false
      }
    },
    "enrich": {"type": ["object", "null"]},
    "resolve_model_paper": {
      "type": ["object", "null"],
      "required": ["decision", "reason", "novelty_kind", "evidence_urls"],
      "properties": {
        "decision": {"enum": ["accept", "reject"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "novelty_kind": {"enum": ["new_weights", "new_method", "new_release", "repackaging", "uncertain"]},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "format": "uri"}
        },
        "existing_paper_id": {"type": ["integer", "null"], "minimum": 1},
        "predecessor_paper_id": {"type": ["integer", "null"], "minimum": 1},
        "arxiv_id": {"type": ["string", "null"], "pattern": "^\\d{4}\\.\\d{4,5}(?:v\\d+)?$"},
        "external_paper": {
          "type": ["object", "null"],
          "required": ["source_url", "title", "abstract", "date_published"],
          "properties": {
            "source_url": {"type": "string", "format": "uri"},
            "title": {"type": "string", "minLength": 1, "maxLength": 1000},
            "abstract": {"type": "string", "minLength": 1, "maxLength": 20000},
            "date_published": {"type": "string", "format": "date"}
          },
          "additionalProperties": false
        },
        "model_release": {
          "type": ["object", "null"],
          "required": ["canonical_name", "publisher", "is_open", "aliases"],
          "properties": {
            "canonical_name": {"type": "string", "minLength": 1, "maxLength": 500},
            "publisher": {"type": "string", "minLength": 1, "maxLength": 255},
            "is_open": {"type": "boolean"},
            "aliases": {"type": "array", "maxItems": 50, "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "review_benchmark_gaps": {
      "type": ["object", "null"],
      "required": ["summary", "decisions"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": {
            "type": "object",
            "required": ["candidate_id", "decision", "reason"],
            "properties": {
              "candidate_id": {"type": "string", "format": "uuid"},
              "decision": {"enum": ["approve", "merge", "reject", "defer"]},
              "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
              "merge_into_candidate_id": {"type": ["string", "null"], "format": "uuid", "description": "Required only for merge: the surviving candidate."}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "add_benchmark": {
      "type": ["object", "null"],
      "required": ["decision", "reason", "evidence_urls"],
      "properties": {
        "decision": {"enum": ["create", "map_existing", "reject", "defer"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 4000},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "format": "uri"}
        },
        "existing_dataset_id": {"type": ["integer", "null"], "minimum": 1},
        "new_dataset": {
          "type": ["object", "null"],
          "required": ["name", "description"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 255},
            "full_name": {"type": ["string", "null"], "maxLength": 500},
            "description": {"type": "string", "minLength": 1, "maxLength": 4000},
            "homepage": {"type": ["string", "null"], "format": "uri"},
            "hf_url": {"type": ["string", "null"], "format": "uri"}
          },
          "additionalProperties": false
        },
        "source_paper": {
          "type": ["object", "null"],
          "description": "Exactly one identity of the paper that introduced the benchmark.",
          "properties": {
            "existing_paper_id": {"type": ["integer", "null"], "minimum": 1},
            "arxiv_id": {"type": ["string", "null"], "pattern": "^\\d{4}\\.\\d{4,5}(?:v\\d+)?$"},
            "external_paper": {
              "type": ["object", "null"],
              "required": ["source_url", "title", "abstract", "date_published"],
              "properties": {
                "source_url": {"type": "string", "format": "uri"},
                "title": {"type": "string", "minLength": 1, "maxLength": 1000},
                "abstract": {"type": "string", "minLength": 1, "maxLength": 20000},
                "date_published": {"type": "string", "format": "date"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "existing_task_id": {"type": ["integer", "null"], "minimum": 1},
        "new_task": {
          "type": ["object", "null"],
          "required": ["name", "description", "keywords", "parent_task_id"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 255},
            "description": {"type": "string", "minLength": 1, "maxLength": 4000},
            "keywords": {"type": "string", "minLength": 1, "maxLength": 1000},
            "parent_task_id": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "array",
          "maxItems": 3,
          "description": "The first metric is the leaderboard's primary metric.",
          "items": {
            "type": "object",
            "properties": {
              "existing_metric_id": {"type": ["integer", "null"], "minimum": 1},
              "new_metric": {
                "type": ["object", "null"],
                "required": ["name", "full_name", "direction", "description"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 100},
                  "full_name": {"type": "string", "minLength": 1, "maxLength": 255},
                  "direction": {"enum": ["higher_is_better", "lower_is_better"]},
                  "scale": {"type": ["string", "null"], "maxLength": 50},
                  "description": {"type": "string", "minLength": 1, "maxLength": 2000}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "supports_harness": {"type": "boolean"},
        "task_choice_reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "description": "Required when the task is not one the reporting papers mostly propose, or a descendant of one."
        },
        "metric_choice_reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 2000,
          "description": "Required when the primary metric is not one the reporting papers mostly report."
        }
      },
      "additionalProperties": false
    },
    "benchmark_gaps": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["reasoning", "local_ref", "gap_type", "proposed_benchmark", "protocol", "catalog_search", "evidence", "blocked_evaluations", "assessment"],
        "properties": {
          "reasoning": {"type": "string", "minLength": 1, "maxLength": 2000},
          "local_ref": {"type": "string", "minLength": 1, "maxLength": 100},
          "gap_type": {"enum": ["dataset_missing", "task_dataset_association_missing", "metric_configuration_missing", "task_missing"]},
          "proposed_benchmark": {
            "type": "object",
            "required": ["name", "aliases", "task_candidates", "canonical_sources"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 500},
              "aliases": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
              "description": {"type": ["string", "null"], "maxLength": 4000},
              "task_candidates": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["task_id"],
                  "properties": {
                    "task_id": {"type": "integer"},
                    "task_name": {"type": ["string", "null"], "maxLength": 500},
                    "confidence": {"enum": ["low", "medium", "high", null]},
                    "reason": {"type": ["string", "null"], "maxLength": 2000}
                  },
                  "additionalProperties": false
                }
              },
              "canonical_sources": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["kind", "url"],
                  "properties": {
                    "kind": {"type": "string", "minLength": 1, "maxLength": 100},
                    "url": {"type": "string", "format": "uri", "maxLength": 2000},
                    "title": {"type": ["string", "null"], "maxLength": 500}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "protocol": {
            "type": "object",
            "required": ["evaluation_protocol", "metrics", "supports_harness"],
            "properties": {
              "dataset_version": {"type": ["string", "null"], "maxLength": 200},
              "splits": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "evaluation_protocol": {"type": "string", "minLength": 1, "maxLength": 4000},
              "metrics": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": ["name", "direction", "definition"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1, "maxLength": 200},
                    "direction": {"enum": ["higher_is_better", "lower_is_better"]},
                    "unit": {"type": ["string", "null"], "maxLength": 200},
                    "native_scale": {"type": ["string", "null"], "maxLength": 200},
                    "definition": {"type": "string", "minLength": 1, "maxLength": 2000}
                  },
                  "additionalProperties": false
                }
              },
              "supports_harness": {"type": "boolean"}
            },
            "additionalProperties": false
          },
          "catalog_search": {
            "type": "object",
            "required": ["queries", "near_matches", "conclusion"],
            "properties": {
              "queries": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
              "near_matches": {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": ["task_id", "dataset_id", "rejection_reason"],
                  "properties": {
                    "task_id": {"type": "integer"},
                    "dataset_id": {"type": "integer"},
                    "dataset_name": {"type": ["string", "null"], "maxLength": 500},
                    "rejection_reason": {"type": "string", "minLength": 1, "maxLength": 2000}
                  },
                  "additionalProperties": false
                }
              },
              "conclusion": {"type": "string", "minLength": 1, "maxLength": 2000}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_kind", "source_url", "snippet", "supports"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1, "maxLength": 100},
                "source_kind": {"enum": ["paper_markdown", "paper_pdf", "paper_source"]},
                "source_url": {"type": "string", "format": "uri", "maxLength": 2000},
                "page": {"type": ["integer", "null"], "minimum": 1},
                "section": {"type": ["string", "null"], "maxLength": 500},
                "table": {"type": ["string", "null"], "maxLength": 500},
                "snippet": {"type": "string", "minLength": 1, "maxLength": 1000},
                "supports": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
              },
              "additionalProperties": false
            }
          },
          "blocked_evaluations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "required": ["local_ref", "model_name", "metrics", "best_metric", "methodology", "uses_additional_data", "is_open", "evidence_ids"],
              "properties": {
                "local_ref": {"type": "string", "minLength": 1, "maxLength": 100},
                "model_name": {"type": "string", "minLength": 1, "maxLength": 500},
                "harness": {"type": ["string", "null"], "maxLength": 500},
                "split": {"type": ["string", "null"], "maxLength": 200},
                "metrics": {"type": "object", "minProperties": 1, "maxProperties": 20, "additionalProperties": {"type": "number"}},
                "best_metric": {"type": "string", "minLength": 1, "maxLength": 200},
                "methodology": {"type": "string", "minLength": 1, "maxLength": 4000},
                "uses_additional_data": {"type": "boolean"},
                "is_open": {"type": "boolean"},
                "num_parameters": {"type": ["integer", "null"], "minimum": 0},
                "hf_model_url": {"type": ["string", "null"], "format": "uri", "maxLength": 2000},
                "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 100}}
              },
              "additionalProperties": false
            }
          },
          "assessment": {
            "type": "object",
            "required": ["recommendation", "confidence", "why_worth_adding", "ambiguities"],
            "properties": {
              "recommendation": {"enum": ["add_candidate", "review"]},
              "confidence": {"enum": ["low", "medium", "high"]},
              "why_worth_adding": {"type": "string", "minLength": 1, "maxLength": 2000},
              "ambiguities": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "validation_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["evaluation_id", "before_state", "field_diff", "evidence"],
        "properties": {
          "evaluation_id": {"type": "integer"},
          "before_state": {"type": "object"},
          "field_diff": {"type": "object"},
          "evidence": {"type": "array", "minItems": 1},
          "duplicate_evaluation_ids": {"type": "array", "items": {"type": "integer"}},
          "duplicate_before_states": {"type": "array", "items": {"type": "object"}},
          "canonical_selection_reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "source_coverage": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["url", "status", "benchmark_outcomes"],
        "properties": {
          "url": {"type": "string", "format": "uri", "maxLength": 2000},
          "status": {"enum": ["inspected", "unavailable"]},
          "benchmark_outcomes": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["benchmark", "disposition", "detail"],
              "properties": {
                "benchmark": {"type": "string", "minLength": 1, "maxLength": 500},
                "disposition": {"enum": ["evaluation", "already_present", "benchmark_gap", "not_paper_native", "not_applicable"]},
                "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
                "task_id": {"type": "integer", "minimum": 1, "description": "Configured leaderboard task. Required for already_present; include whenever the outcome names a configured leaderboard."},
                "dataset_id": {"type": "integer", "minimum": 1, "description": "Configured leaderboard dataset. Required for already_present; include whenever the outcome names a configured leaderboard."},
                "metric": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Exact configured metric name. Required for already_present."},
                "value": {"type": "number", "description": "This paper's best eligible score on the leaderboard scale. Required for already_present; the server checks that this paper already has an equal or better row."}
              },
              "additionalProperties": false
            }
          },
          "detail": {"type": ["string", "null"], "maxLength": 2000}
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["evaluations", "evaluation_removals", "benchmark_gaps", "validation_evidence"]
}
