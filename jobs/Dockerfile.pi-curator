FROM node:22.18.0-bookworm-slim

# Shadow-only curation runner on the Pi harness. It reuses the pinned Codex
# runner module for bootstrap, preflight, prompt, and callbacks.
ARG PI_CLI_VERSION=1.3.0
RUN apt-get update && apt-get install -y --no-install-recommends git python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@earendil-works/pi-coding-agent@${PI_CLI_VERSION}" \
    && pip3 install --break-system-packages --no-cache-dir "PyPDF2==3.0.1"

WORKDIR /runner
COPY jobs/run_paper_curation.py /runner/run_paper_curation.py
COPY jobs/run_pi_curation.py /runner/run_pi_curation.py
RUN test "$(sha256sum /runner/run_paper_curation.py | cut -d' ' -f1)" = \
    "f165a0e4c56a82c9ac80ce8cd29bce7e6e3cf2100ca519de2fe835f105c34271" \
    && test "$(sha256sum /runner/run_pi_curation.py | cut -d' ' -f1)" = \
    "e0bb26500b0cf9f43b5090955c4ae34674bb906299c6a136335fa6e1cd148205"
