FROM node:22.18.0-bookworm-slim

ARG CODEX_CLI_VERSION=0.75.0
RUN apt-get update && apt-get install -y --no-install-recommends git python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
    && pip3 install --break-system-packages --no-cache-dir "PyPDF2==3.0.1"

WORKDIR /runner
COPY jobs/run_paper_curation.py /runner/run_paper_curation.py
RUN test "$(sha256sum /runner/run_paper_curation.py | cut -d' ' -f1)" = \
    "c0e97b88ca86743f5deeeefdb76d7cb110539c0e42d42ad289f872d23bd24028"
