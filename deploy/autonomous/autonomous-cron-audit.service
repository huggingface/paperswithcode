[Unit]
Description=Run the daily autonomous Papers With Code CRON deep audit
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron autonomous_cron_audit
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperswithcode/production/cron-logs
ReadWritePaths=/var/lib/paperswithcode/autonomous-candidates
ReadWritePaths=/var/lib/paperswithcode/autonomous-source-broker
ReadWritePaths=/srv/paperswithcode/repository.git
