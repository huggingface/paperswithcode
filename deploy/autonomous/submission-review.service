[Unit]
Description=Launch one autonomous Papers With Code submission review batch
After=network-online.target postgresql@16-main.service
Wants=network-online.target
OnFailure=submission-review-alert.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron review_submissions
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/paperswithcode/autonomous-submissions
