[Unit]
Description=Papers With Code executor rendezvous (%i)
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target

[Service]
Type=simple
User=pwc-%i
Group=www-data
WorkingDirectory=/srv/paperswithcode/environments/%i/current
RuntimeDirectory=pwc-chat-executor
RuntimeDirectoryMode=0750
LoadCredential=database-url:/etc/paperswithcode/%i-executor-database-url
LoadCredential=signing-key:/etc/paperswithcode/%i-executor-signing-key
ExecStart=/srv/paperswithcode/environments/%i/current/executor_transport/target/release/rendezvous --unix-socket /run/pwc-chat-executor/chat-executor-rendezvous.sock --config /etc/paperswithcode/%i-executor-rendezvous.json --database-url-file ${CREDENTIALS_DIRECTORY}/database-url --signing-key-file ${CREDENTIALS_DIRECTORY}/signing-key
Restart=on-failure
RestartSec=1
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/paperswithcode /etc/paperswithcode
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
