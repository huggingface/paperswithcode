[Unit]
Description=Papers With Code chat executor rendezvous (%I)
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target
ConditionPathExists=/etc/paperswithcode/chat-executor/%I/rendezvous.json
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=pwc-chat-executor
Group=www-data
# No pwc-production/pwc-staging membership: those groups can read the
# environments' env files. Socket ownership changes run as root ("+") instead.
WorkingDirectory=/srv/paperswithcode
RuntimeDirectory=paperswithcode/%I
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LoadCredential=database-url:/etc/paperswithcode/chat-executor/%I/database-url
LoadCredential=signing-key:/etc/paperswithcode/chat-executor/%I/signing-key
ExecStartPre=/srv/paperswithcode/chat-executor/%I/bin/rendezvous --self-test
ExecStart=/srv/paperswithcode/chat-executor/%I/bin/rendezvous --unix-socket /run/paperswithcode/%I/chat-executor-rendezvous.sock --config /etc/paperswithcode/chat-executor/%I/rendezvous.json --database-url-file ${CREDENTIALS_DIRECTORY}/database-url --signing-key-file ${CREDENTIALS_DIRECTORY}/signing-key
ExecStartPost=/usr/bin/test -S /run/paperswithcode/%I/chat-executor-rendezvous.sock
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=250
KillSignal=SIGTERM
UMask=0007
LimitNOFILE=4096
TasksMax=256
MemoryMax=536870912
CPUQuota=200%
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/srv/paperswithcode/chat-executor/%I /etc/paperswithcode/chat-executor/%I
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
