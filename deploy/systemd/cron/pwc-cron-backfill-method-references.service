[Unit]
Description=Backfill method reference evidence hourly
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled backfill_method_references --provider openalex --resume --retry-failures --limit 10000 --max-runtime-seconds 19800
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
