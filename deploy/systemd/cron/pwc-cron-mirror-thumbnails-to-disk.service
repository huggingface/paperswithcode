[Unit]
Description=Mirror thumbnails to VPS disk daily
After=network-online.target postgresql@16-main.service
After=pwc-cron-preload-thumbnails-recent.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled mirror_thumbnails_to_disk
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
