[Unit]
Description=Preload thumbnails for recent papers daily
After=network-online.target postgresql@16-main.service
After=pwc-cron-import-hf-daily-papers.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled preload_thumbnails --priority recent --recent-days 30 --limit 500
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
