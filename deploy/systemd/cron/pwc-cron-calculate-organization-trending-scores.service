[Unit]
Description=Calculate organization trending scores daily
After=network-online.target postgresql@16-main.service
After=pwc-cron-sync-hf-organizations.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled calculate_organization_trending_scores
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
