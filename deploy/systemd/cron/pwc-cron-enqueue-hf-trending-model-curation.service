[Unit]
Description=Enqueue Hugging Face trending model curation hourly
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled enqueue_hf_trending_model_curation
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
