[Unit]
Description=Link papers by task keywords weekly
After=network-online.target postgresql@16-main.service
After=pwc-cron-link-methods-by-references.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled link_papers_by_task_keywords
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
