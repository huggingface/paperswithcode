[Unit]
Description=Preload thumbnails for top task-page papers daily
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled preload_thumbnails --priority task-top --per-task 50 --missing-only --trust-local-cache --max-runtime-seconds 6000
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
