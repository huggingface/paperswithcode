[Unit]
Description=Dispatch layout OCR for papers indexed in the last day
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
# Slot 3 is reserved for short refreshes; bulk jobs use slots 0-2.
Environment=PWC_CRON_THROTTLE_SLOTS=4
ExecStart=/usr/local/sbin/pwc-cron-throttled paper_markdown_backfill --lane fresh --execute --confirm
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
