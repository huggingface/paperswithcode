[Unit]
Description=Refresh paper embeddings hourly
After=network-online.target postgresql@16-main.service
After=pwc-cron-import-hf-daily-papers.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled refresh_paper_embeddings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
