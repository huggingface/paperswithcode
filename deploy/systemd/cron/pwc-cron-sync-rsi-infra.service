[Unit]
Description=Sync RSI-Infra Bench leaderboard from ai4ai-for-anything.github.io hourly
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled sync_rsi_infra
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
