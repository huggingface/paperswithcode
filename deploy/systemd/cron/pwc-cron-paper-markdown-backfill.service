[Unit]
Description=Reconcile paper Markdown live and full backfill lanes hourly
After=network-online.target postgresql@16-main.service
After=pwc-cron-import-hf-daily-papers.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled paper_markdown_backfill --execute --confirm
ExecStart=/usr/local/sbin/pwc-cron-throttled paper_markdown_backfill --full --execute --confirm
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
