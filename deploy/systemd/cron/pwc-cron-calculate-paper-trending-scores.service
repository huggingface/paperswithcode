[Unit]
Description=Calculate paper trending scores hourly
After=network-online.target postgresql@16-main.service
After=pwc-cron-update-github-stars.service pwc-cron-update-hf-artifacts.service pwc-cron-calculate-trending-scores.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled calculate_paper_trending_scores
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
