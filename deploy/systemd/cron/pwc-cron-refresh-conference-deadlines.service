[Unit]
Description=Collect deadline research and check imminent deadlines daily
After=network-online.target postgresql@16-main.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pwc-cron-throttled refresh_conference_deadlines
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/paperswithcode/cron-slots
