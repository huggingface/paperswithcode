PWC_POSTGRES_BACKUP_DB_USER=pwc_backup
PWC_POSTGRES_BACKUP_DB_PASSWORD=replace
PWC_POSTGRES_BACKUP_HF_TOKEN=replace
PWC_POSTGRES_BACKUP_BUCKET=huggingface/paperswithcode-backups
PWC_POSTGRES_BACKUP_DIR=/var/lib/paperswithcode/production/backups
PWC_HF_TOKEN=replace-write-capable-automation-token
PWC_ENRICHMENT_DASHBOARD_REPO_ID=your-namespace/enrichment-dashboard-data
PWC_ENRICHMENT_DASHBOARD_SPACE_REPO_ID=your-namespace/enrichment-dashboard
PWC_GITHUB_TOKEN=replace
PWC_GITHUB_TOKEN_HOT=
PWC_GITHUB_HOT_THRESHOLD_MINUTES=15
PWC_GITHUB_HOT_MAX_UPDATES=500
PWC_GITHUB_HOT_DELAY_SECONDS=0.25
PWC_GITHUB_RATE_LIMIT_RESERVE=500
# Weekly/backfill star queue token from a second GitHub account. The legacy
# name GITHUB_CLASSIC_TOKEN_AICONSULTANCYNIELSROGGE is read when this is unset.
PWC_GITHUB_TOKEN_WEEKLY=replace
# Evaluation outreach: PWC_GITHUB_TOKEN must belong to this login, and the
# signer introduces and signs every outreach issue.
PWC_GITHUB_OUTREACH_LOGIN=NielsRogge
PWC_GITHUB_OUTREACH_SIGNER=Niels
PWC_TRENDING_PIN_ARXIV_IDS=
PWC_TRENDING_PIN_PAPER_IDS=
PWC_GEMINI_API_KEY=replace
PWC_OPENROUTER_API_KEY=replace
PWC_SEMANTIC_SCHOLAR_API_KEY=replace
# Autonomous submission review uses credentials dedicated to this operator.
# Keep mutation disabled until the Task 15 shadow/drill gate is complete.
PWC_AUTONOMOUS_SUBMISSION_JOBS_ENABLED=false
PWC_AUTONOMOUS_SUBMISSION_HF_NAMESPACE=replace
PWC_AUTONOMOUS_SUBMISSION_HF_TOKEN=replace-launch-only-token
PWC_AUTONOMOUS_SUBMISSION_OPENAI_API_KEY=replace-budget-capped-key
PWC_AUTONOMOUS_SUBMISSION_JOB_IMAGE=registry.example/submission-reviewer@sha256:replace-with-64-character-digest
PWC_AUTONOMOUS_SUBMISSION_RUN_BUDGET_USD=5
PWC_AUTONOMOUS_SUBMISSION_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_SUBMISSION_CACHED_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_SUBMISSION_OUTPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_ALERT_SLACK_WEBHOOK_URL=replace-primary-alert-route
PWC_AUTONOMOUS_ALERT_FALLBACK_WEBHOOK_URL=replace-independent-fallback-route
PWC_AUTONOMOUS_DIGEST_WEBHOOK_URL=replace-codex-mobile-digest-route
PWC_AUTONOMOUS_ALERT_RUNBOOK_URL=https://replace.example/runbooks/autonomous-submissions
# Dedicated synthetic chat identity; never reuse a human session or place these
# values in the application environment.
PWC_CHAT_SYNTHETIC_EXPECTED_USERNAME=replace-dedicated-monitor-username
PWC_CHAT_SYNTHETIC_SESSION_COOKIE=replace-dedicated-monitor-session
PWC_CHAT_LANGFUSE_TRACE_CONTENT_ACCESS_ENABLED=true
# The broker, not the operator process, owns the provider credential and applies
# each signed per-run reservation. Broker token and HMAC verification key are
# CRON-only secrets.
PWC_AUTONOMOUS_CODEX_CREDENTIAL_BROKER=/usr/local/sbin/replace-credential-broker
PWC_AUTONOMOUS_CODEX_BROKER_TOKEN=replace-broker-token
PWC_AUTONOMOUS_CODEX_RESERVATION_VERIFY_KEY=replace-at-least-32-byte-hmac-key
PWC_AUTONOMOUS_CODEX_EXECUTABLE=/usr/local/bin/codex
PWC_AUTONOMOUS_CODEX_BWRAP_EXECUTABLE=/usr/bin/bwrap
PWC_AUTONOMOUS_CODEX_UPSTREAM_BASE_URL=https://api.openai.com/v1
PWC_AUTONOMOUS_CODEX_UPSTREAM_HOST_ALLOWLIST=api.openai.com
PWC_AUTONOMOUS_CODEX_PRICING_REVISION=replace-pinned-pricing-revision
PWC_AUTONOMOUS_CODEX_LUNA_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_CODEX_LUNA_CACHED_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_CODEX_LUNA_OUTPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_CODEX_TERRA_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_CODEX_TERRA_CACHED_INPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_CODEX_TERRA_OUTPUT_USD_PER_MILLION=replace-pinned-price
PWC_AUTONOMOUS_PER_RUN_COST_USD=10
PWC_AUTONOMOUS_PER_RUN_TOKENS=200000
PWC_AUTONOMOUS_DAILY_COST_USD=25
PWC_AUTONOMOUS_DAILY_TOKENS=1000000
PWC_AUTONOMOUS_MONTHLY_COST_USD=250
PWC_AUTONOMOUS_MONTHLY_TOKENS=10000000
